# Build
.gradle/
build/
**/build/
out/
**/out/

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Kotlin
*.kotlin_metadata
# Kotlin 编译器本地会话/错误日志（机器相关，不入库）
.kotlin/

# Local work files
.workbuddy/
*.local

# DSH 本地 skill 根（.dsh/skills 下是指向本机 ~/.workbuddy/skills 的 junction，
# 绝对路径机器相关，绝不能进仓库）
.dsh/
.agents/
# Qoder 本地 skill 副本（.qoder/skills 系本机 ~/.claude/skills 拷贝，机器相关，不入库）
.qoder/

# Reference projects (external repos for study, 214M)
reference/

# clipstream/ —— animeko 参考提取（"影子树"）。保留原相对路径与原包名 me.him188.ani.*，
# 依赖外部 mediamp/Koin/Compose，**不是可编译工程**，仅作研读，故与 reference/ 同等对待。
# 由 clipstream/extract.sh 生成、可重跑，重复入库没有意义。
clipstream/

# Caches
.cxx/
local.properties
# Gradle 用户目录（因沙箱限制工作区外不可写，故置于工作区内，约 6G）
.gradle-home/

# Logs
*.log

# echgate（本地 ECH 网关，Go）——只入库源码。
# 构建产物由 `go build` 生成后拷进 desktopApp/src/main/resources/ 作为应用资源，
# 那一份才随仓库走；这份是本地的中间产物，重复提交没意义。
echgate/echgate.exe

# Python 字节码（验收脚本的 py_compile 产物）
__pycache__/
*.pyc
