# Build
.gradle/
build/
**/build/
out/
**/out/

# IDE
.idea/
*.iml
.vscode/
.DS_Store

# Kotlin
*.kotlin_metadata
# Kotlin 编译器本地会话/错误日志（机器相关，不入库）
.kotlin/

# Local work files
.workbuddy/
*.local

# DSH 本地 skill 根（.dsh/skills 下是指向本机 ~/.workbuddy/skills 的 junction，
# 绝对路径机器相关，绝不能进仓库）
.dsh/
.agents/
# Qoder 本地 skill 副本（.qoder/skills 系本机 ~/.claude/skills 拷贝，机器相关，不入库）
.qoder/

# Reference projects (external repos for study, 214M)
reference/

# Caches
.cxx/
local.properties
# Gradle 用户目录（因沙箱限制工作区外不可写，故置于工作区内，约 6G）
.gradle-home/

# Logs
*.log

# echgate（本地 ECH 网关，Go）——只入库源码。
# 构建产物由 `go build` 生成后拷进 desktopApp/src/main/resources/ 作为应用资源，
# 那一份才随仓库走；这份是本地的中间产物，重复提交没意义。
echgate/echgate.exe
