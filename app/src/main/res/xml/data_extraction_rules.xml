<?xml version="1.0" encoding="utf-8"?>
<!--
  登录态独立文件（datastore/auth.preferences_pb）不随系统备份漫游 ——
  与手动备份的 AUTH_KEYS 同口径（already_login / saved_user_id / cookie /
  cf_cookies / danmaku_app_id / danmaku_app_secret）。
  普通设置（settings.preferences_pb）与数据库照常漫游。
  整机传输同样排除：手动备份是用户主动行为尚且不带登录态，系统行为不该更宽。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
