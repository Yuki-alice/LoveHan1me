# 全仓统一 LF：项目在 macOS / Windows 之间来回拷贝，禁止自动换行转换
* text=auto eol=lf

# 二进制资源不参与换行处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.jar  binary
*.ttf  binary
*.otf  binary
*.mp4  binary
*.glsl text eol=lf

# Windows 批处理脚本必须保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
